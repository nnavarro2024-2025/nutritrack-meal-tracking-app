{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nutritrack.example/schemas/diagnosis.schema.json",
  "title": "Nutrition diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": ["problem", "etiology", "signsSymptoms", "generatedSentence"],
  "properties": {
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term"],
      "properties": {
        "term": {
          "$ref": "https://nutritrack.example/schemas/terminology.json#/definitions/diagnosisTerm"
        },
        "code": {
          "$ref": "https://nutritrack.example/schemas/terminology.json#/definitions/diagnosisCode"
        }
      }
    },
    "etiology": {
      "type": "string",
      "minLength": 1
    },
    "signsSymptoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generatedSentence": {
      "type": "string",
      "minLength": 1,
      "description": "Must equal: [Problem] related to [Etiology] as evidenced by [Signs/Symptoms]. Signs and symptoms are joined with semicolon-space."
    }
  }
}
